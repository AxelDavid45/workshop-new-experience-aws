# Configuración de npm contra ataques a la cadena de suministro (supply chain).
# npm lee este archivo cuando corres cualquier comando dentro de este repo.
# Necesitas npm 11.10 o superior (npm install -g npm@latest).

# Ningún paquete corre código (preinstall, install, postinstall) al instalarse.
# Los ataques como Shai-Hulud se disparaban justo ahí.
ignore-scripts=true

# No instala versiones publicadas hace menos de 7 días. Casi todos los
# paquetes maliciosos se detectan y se retiran en horas.
min-release-age=7

# package.json guarda la versión exacta, sin ^ ni ~.
save-exact=true

# No acepta dependencias que vengan de un repo de git ni de una URL suelta,
# solo del registro de npm.
allow-git=none
allow-remote=none

# Falla si tu Node no cumple "engines" de package.json. "engines" no pide una
# versión de npm, porque Amplify construye con el npm de su propia imagen y el
# build fallaría. La versión de npm la revisa npm run verify 1.
engine-strict=true

# Menos ruido en la terminal.
fund=false
